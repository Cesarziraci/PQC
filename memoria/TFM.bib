@inproceedings{schoffel_code-based_2022,
	location = {Yokohama, Japan},
	title = {Code-based Cryptography in {IoT}: A {HW}/{SW} Co-Design of {HQC}},
	rights = {https://doi.org/10.15223/policy-029},
	isbn = {978-1-6654-9153-2},
