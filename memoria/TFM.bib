	issn = {2569-2925},
	url = {https://ojs.ub.rub.de/index.php/TCHES/article/view/9307},
	doi = {10.46586/tches.v2022.i1.557-588},
	shorttitle = {Racing {BIKE}},
	abstract = {{BIKE} is a Key Encapsulation Mechanism selected as an alternate candidate in {NIST}’s {PQC} standardization process, in which performance plays a signiﬁcant role in the third round. This paper presents {FPGA} implementations of {BIKE} with the best area-time performance reported in literature. We optimize two key arithmetic operations, which are the sparse polynomial multiplication and the polynomial inversion. Our sparse multiplier achieves time-constancy for sparse polynomials of indeﬁnite Hamming weight used in {BIKE}’s encapsulation. The polynomial inversion is based on the extended Euclidean algorithm, which is unprecedented in current {BIKE} implementations. Our optimized design results in a 5.5 times faster key generation compared to previous implementations based on Fermat’s little theorem.},
