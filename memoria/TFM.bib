@article{samandari_mceliece_nodate,
	title = {{McEliece} Post Quantum Cryptography for {IoT}},
	abstract = {Quantum computers are computers that will function in a completely diﬀerent way to standard computers and due to this render all our current cryptographic standards ineﬀective. To combat this, post quantum cryptographic standards that will keep information and communication secure, even after quantum computers are available, are being evaluated. A thorough evaluation of post quantum cryptographic standards requires inclusion of Internet of Things ({IoT}) devices because these devices will need to provide continued security in a post quantum environment, but have diﬀerent considerations to other devices. In this report, we outline an analysis of the {McEliece} post quantum cryptosystem and its possible use for {IoT} devices. We have concluded that there is a possibility for Classic {McEliece} to be used for {IoT} devices. However, these will need to be {IoT} devices that are less resource constrained in order for the use of Classic {McEliece} to be practical.},
	author = {Samandari, Juliet and Gritti, Dr Clementine},
	langid = {english},
	file = {PDF:C\:\\Users\\lopox\\Zotero\\storage\\PFSEZTRP\\Samandari y Gritti - McEliece Post Quantum Cryptography for IoT.pdf:application/pdf},
}

@inproceedings{perez-pacheco_mceliece_2023,
	location = {Vilanova i la Geltru, Spain},
	title = {{McEliece} Cryptosystem: Reducing the Key Size with {QC}-{LDPC} codes},
