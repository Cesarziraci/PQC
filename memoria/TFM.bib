}

@article{urian_classic_nodate,
	title = {Classic {McEliece} Key Generation on {RAM} constrained devices},
	abstract = {Classic {McEliece} is a code based encryption scheme and candidate of the {NIST} post quantum contest. Implementing Classic {McEliece} on smart card chips is a challenge, because those chips have only a very limited amount of {RAM}. Decryption is not an issue because the cryptogram size is short and the decryption algorithm can be implemented using very few {RAM}. However key generation is a concern, because a large binary matrix must be inverted.},
